/* Design tokens */
    :root{
      --ink:#18211d;--forest:#173c32;--deep-forest:#0f2922;--ivory:#faf7f0;
      --paper:#fffdf8;--sand:#e8ded0;--oat:#f1ebe1;--sage:#9ead97;
      --clay:#c66f55;--soft-clay:#e8b5a4;--gold:#c7a566;--muted:#6d746f;
      --white:#fff;--danger:#8a3438;--line:rgba(24,33,29,.14);
      --shadow:0 24px 70px rgba(24,33,29,.1);--container:1280px;
    }

    /* Global styles */
    *,*::before,*::after{box-sizing:border-box}
    html{scroll-behavior:auto}
    body{--nav-h:64px;margin:0;background:#fbf9f4;color:#26352f;font-family:"Manrope",sans-serif;line-height:1.6;letter-spacing:-.006em;overflow-x:hidden}
    body.menu-open{overflow:hidden}
    button,a{font:inherit}button{color:inherit}a{color:inherit}img{display:block;max-width:100%}
    h1,h2,h3,p{margin-top:0}
    h1,h2,h3{font-family:"Cormorant Garamond",serif;font-weight:500;line-height:.95;letter-spacing:-.035em}
    .container{width:min(var(--container),calc(100% - 64px));margin-inline:auto}
    .sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    :focus-visible{outline:3px solid var(--gold);outline-offset:4px}
    ::selection{background:var(--forest);color:var(--white)}
    .eyebrow{display:block;margin-bottom:16px;color:var(--gold);font-size:.68rem;font-weight:700;letter-spacing:.27em;text-transform:uppercase}
    .btn{min-height:54px;padding:14px 27px;border:1px solid transparent;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;gap:12px;font-weight:700;text-decoration:none;cursor:pointer;transition:transform .25s ease,background .25s ease,color .25s ease,box-shadow .25s ease}
    .btn:hover{transform:translateY(-2px)}
    .btn-primary{background:var(--forest);color:var(--white);box-shadow:0 12px 30px rgba(23,60,50,.18)}
    .btn-primary:hover{background:var(--deep-forest);box-shadow:0 16px 38px rgba(23,60,50,.24)}
    .btn-ghost{border-color:rgba(255,255,255,.55);color:var(--white);background:rgba(255,255,255,.05)}
    .btn-ghost:hover{background:var(--white);color:var(--ink)}
    .btn:disabled{opacity:.42;cursor:not-allowed;transform:none;box-shadow:none}

    /* Navigation */
    .nav{position:fixed;z-index:50;inset:0 0 auto;height:var(--nav-h);color:#173e32;border-bottom:1px solid rgba(53,82,67,.13);background:linear-gradient(110deg,rgba(255,253,247,.93),rgba(234,241,230,.87));box-shadow:0 8px 28px rgba(30,53,42,.09),inset 0 1px 0 rgba(255,255,255,.94);backdrop-filter:blur(22px) saturate(1.16);-webkit-backdrop-filter:blur(22px) saturate(1.16);transition:background .3s ease,color .3s ease,border-color .3s ease,box-shadow .3s ease}
    .nav.scrolled{color:#123b2f;background:linear-gradient(110deg,rgba(255,253,247,.97),rgba(230,240,228,.94));border-color:rgba(48,78,63,.16);box-shadow:0 12px 38px rgba(24,45,35,.13),inset 0 1px 0 #fff;backdrop-filter:blur(26px) saturate(1.2);-webkit-backdrop-filter:blur(26px) saturate(1.2)}
    .nav-inner{height:100%;display:flex;align-items:center;justify-content:space-between}
    .logo{font-family:"Cormorant Garamond",serif;color:#153f33;font-size:1.43rem;font-weight:650;letter-spacing:.09em;text-decoration:none;text-shadow:0 1px 0 rgba(255,255,255,.8)}
    .nav-links{display:flex;align-items:center;gap:27px}
    .nav-links a{position:relative;color:#214d3f;font-size:.71rem;font-weight:800;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;text-shadow:0 1px 0 rgba(255,255,255,.65);transition:color .25s ease,opacity .25s ease}
    .nav-links a:hover,.nav-links a.active{color:#0e382b}
    .nav-links a::after{content:"";position:absolute;left:0;right:100%;bottom:-8px;height:1px;background:currentColor;transition:right .25s ease}
    .nav-links a:hover::after,.nav-links a.active::after{right:0}
    .nav-toggle{display:none;border:0;background:transparent;padding:10px;cursor:pointer}
    .nav-toggle span{display:block;width:24px;height:2px;margin:5px;background:currentColor}

    /* Mint botanical hero */
    .home{position:relative;min-height:100svh;display:flex;align-items:center;color:var(--forest);isolation:isolate;overflow:hidden;background:#eaf4e6}
    .hero-bg{position:absolute;z-index:-3;inset:-2% 0;background:url("../images/editorial/mint-skincare-hero-v2.png") 50% 50%/cover no-repeat;transform:translate3d(var(--hero-depth-x,0),calc(var(--hero-bg-y,0px) + var(--hero-depth-y,0px)),0) scale(1.025);animation:heroImageReveal 1.35s cubic-bezier(.22,.7,.2,1) both;will-change:transform}
    .hero-model-foreground{position:absolute;z-index:0;inset:-2% 0;background:url("../images/editorial/mint-skincare-hero-v2.png") 50% 50%/cover no-repeat;transform:translate3d(var(--hero-depth-x,0),calc(var(--hero-bg-y,0px) + var(--hero-depth-y,0px)),0) scale(1.025);pointer-events:none;mask-image:linear-gradient(90deg,transparent 0 43%,rgba(0,0,0,.2) 48%,rgba(0,0,0,.88) 55%,#000 61%);-webkit-mask-image:linear-gradient(90deg,transparent 0 43%,rgba(0,0,0,.2) 48%,rgba(0,0,0,.88) 55%,#000 61%);will-change:transform}
    .home::before{content:"";position:absolute;z-index:-2;inset:0;background:linear-gradient(90deg,rgba(244,250,239,.94) 0%,rgba(238,247,234,.75) 34%,rgba(232,244,228,.18) 58%,transparent 75%)}
    .home::after{content:"";position:absolute;z-index:-1;left:5.5%;bottom:8%;width:110px;height:110px;border:1px solid rgba(255,255,255,.52);border-radius:50%;box-shadow:42px -470px 0 -49px rgba(255,255,255,.7),105px -390px 0 -41px rgba(255,255,255,.55),-24px -240px 0 -45px rgba(255,255,255,.62);opacity:.75;animation:heroOrbs 6s ease-in-out infinite}
    .hero-display-word{--display-opacity:.42;position:absolute;z-index:-1;left:50%;top:49%;width:108%;color:rgba(255,250,235,.9);font-family:"Manrope",sans-serif;font-size:clamp(7rem,14.6vw,13.5rem);font-weight:750;line-height:.78;letter-spacing:.03em;text-align:center;white-space:nowrap;mix-blend-mode:soft-light;opacity:0;transform:translate(-50%,calc(-44% + var(--display-parallax,0px))) scale(.96);pointer-events:none;animation:displayWordReveal 1.4s cubic-bezier(.2,.78,.2,1) .15s forwards;will-change:transform}
    .hero-inner{min-height:100svh;padding:calc(var(--nav-h) + 44px) 0 44px;display:flex;align-items:center}
    .hero-copy{position:relative;z-index:2;max-width:670px;transform:translate3d(var(--copy-depth-x,0),var(--copy-depth-y,0),0);transition:transform .65s cubic-bezier(.2,.78,.2,1);will-change:transform}
    .hero-nature{display:block;margin-bottom:24px;color:#5d7965;font-size:.67rem;font-weight:800;letter-spacing:.22em;text-transform:uppercase;opacity:0;animation:heroTracking 1s .12s cubic-bezier(.22,.7,.2,1) forwards}
    .hero-copy h1{position:relative;max-width:620px;margin-bottom:14px;color:#183f34;font-size:clamp(4.15rem,7.2vw,7.1rem);line-height:.8;text-shadow:0 8px 34px rgba(24,63,52,.08)}
    .hero-subtitle{position:relative;display:block;width:max-content;max-width:100%;margin-bottom:14px;padding-bottom:5px;color:#4e705b;font-family:"Cormorant Garamond",serif;font-size:clamp(1.5rem,2.25vw,2.15rem);font-weight:600;letter-spacing:-.02em;opacity:0;transform:translateY(18px);animation:heroCopyReveal .85s .62s cubic-bezier(.22,.7,.2,1) forwards}
    .hero-subtitle::after{content:"";position:absolute;left:0;bottom:0;width:54px;height:1px;background:linear-gradient(90deg,#a98245,#dbc180);transform:scaleX(0);transform-origin:left;animation:heroLineReveal .8s 1.05s cubic-bezier(.22,.7,.2,1) forwards}
    .hero-copy p{max-width:490px;margin-bottom:24px;color:#465f53;font-size:.96rem;line-height:1.68;opacity:0;transform:translateY(18px);filter:blur(4px);animation:heroCopyReveal .9s .77s cubic-bezier(.22,.7,.2,1) forwards}
    .hero-actions{display:flex;gap:14px;flex-wrap:wrap;opacity:0;transform:translateY(16px);animation:heroCopyReveal .85s .94s cubic-bezier(.22,.7,.2,1) forwards}
    .hero-actions .btn{min-width:185px}
    .home .btn-primary{background:linear-gradient(135deg,#1f5949,#163f35);color:#fff;box-shadow:0 14px 32px rgba(31,89,73,.2)}
    .home .btn-primary:hover{background:#123a30;box-shadow:0 18px 38px rgba(31,89,73,.26)}
    .home .btn-ghost{border-color:rgba(31,89,73,.34);color:var(--forest);background:rgba(255,255,255,.42);backdrop-filter:blur(10px)}
    .home .btn-ghost:hover{background:#fff;color:var(--forest)}
    .home .btn{position:relative;overflow:hidden}
    .home .btn::after{content:"";position:absolute;inset:-80% auto -80% -35%;width:28%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.62),transparent);transform:rotate(18deg) translateX(-220%);transition:transform .75s cubic-bezier(.22,.7,.2,1)}
    .home .btn:hover::after{transform:rotate(18deg) translateX(620%)}
    .hero-atmosphere{position:absolute;z-index:-1;inset:0;overflow:hidden;pointer-events:none}
    .serum-bubble{position:absolute;border:1px solid rgba(255,255,255,.76);border-radius:50%;background:radial-gradient(circle at 30% 24%,rgba(255,255,255,.9),rgba(223,241,226,.24) 42%,rgba(153,190,166,.12) 72%,transparent);box-shadow:inset 0 0 22px rgba(255,255,255,.6),0 12px 34px rgba(53,91,72,.11);backdrop-filter:blur(2px);animation:serumFloat var(--float-duration,9s) ease-in-out infinite}
    .serum-bubble:nth-child(1){left:7%;top:22%;width:28px;height:28px;--float-duration:7.5s}
    .serum-bubble:nth-child(2){left:42%;top:14%;width:54px;height:54px;--float-duration:10s;animation-delay:-3s}
    .serum-bubble:nth-child(3){left:34%;bottom:12%;width:76px;height:76px;--float-duration:12s;animation-delay:-6s}
    .liquid-orb{position:absolute;border-radius:45% 55% 58% 42%/53% 45% 55% 47%;filter:blur(1px);opacity:.42;background:linear-gradient(145deg,rgba(255,255,255,.75),rgba(188,215,191,.28));box-shadow:inset 18px 18px 40px rgba(255,255,255,.3);animation:liquidMorph 13s ease-in-out infinite}
    .liquid-orb.one{width:280px;height:210px;left:-7%;bottom:-5%}.liquid-orb.two{width:180px;height:150px;left:39%;top:30%;animation-delay:-6s}
    .hero-word{display:inline-block;margin-right:.16em;opacity:0;clip-path:inset(100% 0 0);filter:blur(7px);transform:translate3d(0,42px,0) rotate(1.5deg);animation:wordReveal 1s cubic-bezier(.18,.78,.18,1) forwards;animation-delay:calc(.2s + var(--word-index)*.11s)}
    @keyframes heroRise{from{opacity:0;transform:translate3d(0,28px,0)}to{opacity:1;transform:none}}
    @keyframes heroImageReveal{from{opacity:.35;filter:saturate(.7) blur(8px)}to{opacity:1;filter:saturate(1) blur(0)}}
    @keyframes heroOrbs{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(12px,-14px,0) scale(1.06)}}
    @keyframes serumFloat{0%,100%{transform:translate3d(0,0,0) scale(1)}45%{transform:translate3d(13px,-22px,0) scale(1.07)}70%{transform:translate3d(-7px,-10px,0) scale(.96)}}
    @keyframes liquidMorph{0%,100%{transform:translate3d(0,0,0) rotate(0);border-radius:45% 55% 58% 42%/53% 45% 55% 47%}50%{transform:translate3d(18px,-18px,0) rotate(7deg);border-radius:60% 40% 43% 57%/40% 58% 42% 60%}}
    @keyframes heroTracking{from{opacity:0;letter-spacing:.34em;transform:translateY(10px)}to{opacity:1;letter-spacing:.22em;transform:none}}
    @keyframes heroCopyReveal{to{opacity:1;transform:none;filter:blur(0)}}
    @keyframes heroLineReveal{to{transform:scaleX(1)}}
    @keyframes wordReveal{to{opacity:1;clip-path:inset(0 0 0);filter:blur(0);transform:none}}
    @keyframes displayWordReveal{to{opacity:var(--display-opacity);letter-spacing:-.07em;transform:translate(-50%,calc(-50% + var(--display-parallax,0px))) scale(1)}}

    /* Video scroll */
    .video-scroll{position:relative;height:220vh;background:#fbf9f4;color:#26352f}
    .video-sticky{position:sticky;top:0;height:100svh;display:grid;place-items:center;overflow:hidden;background:linear-gradient(145deg,#f9f6ee,#edf1e7)}
    .video-frame{position:absolute;inset:0;width:100%;height:100%;overflow:hidden;isolation:isolate;background:#f7f4ed;border:1px solid rgba(70,94,79,.1);box-shadow:0 24px 70px rgba(38,61,49,.1);clip-path:inset(0 var(--video-inset,12%) round var(--video-radius,28px));will-change:clip-path}
    .video-frame video,.video-fallback{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;filter:none}
    .video-trio{position:absolute;inset:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:minmax(0,1fr);align-items:stretch;gap:12px;padding:14px;background:linear-gradient(135deg,#edf1e8,#f7f2e9)}
    .video-frame .video-trio>video{position:relative;inset:auto;display:block;width:100%;max-width:none;height:100%;min-width:0;min-height:0;aspect-ratio:auto;object-fit:cover;object-position:center;border:1px solid rgba(255,255,255,.85);border-radius:18px;opacity:.9;mix-blend-mode:normal;filter:saturate(.94) contrast(1.02);box-shadow:0 16px 40px rgba(38,58,48,.11);transition:opacity .35s ease,filter .35s ease}
    .video-frame::before,.video-frame::after{content:"";position:absolute;z-index:2;border-radius:50%;pointer-events:none;mix-blend-mode:screen;filter:blur(6px);opacity:.46}
    .video-frame::before{width:180px;height:180px;left:8%;top:8%;background:radial-gradient(circle,rgba(255,255,255,.72),rgba(190,218,197,.16) 55%,transparent 72%);animation:videoGlow 9s ease-in-out infinite}
    .video-frame::after{width:240px;height:240px;right:4%;bottom:5%;background:radial-gradient(circle,rgba(247,226,191,.42),rgba(255,255,255,.1) 55%,transparent 72%);animation:videoGlow 11s ease-in-out -5s infinite reverse}
    .motion-ready .video-scroll .video-frame{opacity:.55;transform:scale(.97);transition:opacity .9s ease,transform 1.15s cubic-bezier(.2,.78,.2,1)}
    .motion-ready .video-scroll.is-visible .video-frame{opacity:1;transform:scale(1)}
    .video-scroll.is-visible .video-trio>video{animation:mediaBreathe 7s ease-in-out infinite}
    .video-scroll.is-visible .video-trio>video:nth-child(2){animation-delay:-2.3s}.video-scroll.is-visible .video-trio>video:nth-child(3){animation-delay:-4.6s}
    @keyframes videoGlow{0%,100%{transform:translate3d(0,0,0) scale(.9);opacity:.3}50%{transform:translate3d(18px,-14px,0) scale(1.15);opacity:.56}}
    @keyframes mediaBreathe{0%,100%{filter:saturate(.92) contrast(1.02) brightness(.98)}50%{filter:saturate(1) contrast(1.035) brightness(1.035)}}
    .video-fallback{display:none}
    .video-shade{position:absolute;z-index:1;inset:0;background:linear-gradient(0deg,rgba(238,237,228,.9) 0%,rgba(244,242,234,.36) 34%,rgba(246,244,237,.04) 56%,transparent 70%)}
    .video-copy{position:relative;z-index:2;width:min(1180px,calc(100% - 64px));height:100%;pointer-events:none}
    .video-moment{position:absolute;left:50%;bottom:3.5%;width:min(510px,64vw);margin:0;padding:12px 20px 14px;color:#173d30;text-align:center;font-family:"Cormorant Garamond",serif;font-size:clamp(1.7rem,2.45vw,2.75rem);font-weight:600;line-height:.98;letter-spacing:-.022em;border:1px solid rgba(255,255,255,.66);border-radius:16px;background:linear-gradient(145deg,rgba(255,253,247,.65),rgba(236,242,233,.5));box-shadow:0 12px 34px rgba(35,52,43,.1),inset 0 1px 0 rgba(255,255,255,.78);backdrop-filter:blur(8px) saturate(1.05);opacity:0;transform:translate3d(-50%,18px,0);text-shadow:0 1px 0 rgba(255,255,255,.6);will-change:opacity,transform}
    .video-moment small{display:block;margin-bottom:5px;color:#906f39;font-family:"Manrope",sans-serif;font-size:.53rem;font-weight:800;letter-spacing:.19em;text-transform:uppercase}
    .video-transition{position:absolute;z-index:3;left:0;right:0;bottom:-1px;height:10vh;background:#fbf9f4;clip-path:ellipse(78% 58% at 50% 100%);transform:translateY(var(--transition-y,100%));will-change:transform}

    /* Find Your Match */
    .match{position:relative;padding:70px 0 68px;overflow:clip;background:radial-gradient(circle at 5% 16%,rgba(165,177,145,.19),transparent 25%),radial-gradient(circle at 96% 36%,rgba(211,181,139,.16),transparent 24%),linear-gradient(145deg,#fbf7ef 0%,#f1eadf 52%,#e5eadf 100%);color:#283932;scroll-margin-top:var(--nav-h)}
    .match-head{display:block}
    .match-intro{max-width:930px;margin:0 auto 32px;text-align:center}
    .match-portrait{display:none}
    .match-intro-copy{position:relative}
    .match-intro h2{margin-bottom:12px;color:#283932;font-size:clamp(3.7rem,5.6vw,5.8rem)}
    .match-intro p{max-width:620px;margin:0 auto;color:#6c776f;font-size:.92rem;line-height:1.55}
    .filter-panel{max-width:none;margin:0;padding:clamp(24px,2.7vw,36px);background:rgba(255,253,248,.92);border:1px solid rgba(69,91,77,.12);border-radius:24px;box-shadow:0 18px 52px rgba(65,57,47,.075)}
    .filter-kicker{display:none}
    fieldset{position:relative;border:0;padding:0;margin:0 0 32px;min-width:0}
    fieldset+fieldset{padding-top:28px;border-top:1px solid rgba(75,93,79,.13)}
    legend{width:100%;padding:0;font-family:"Cormorant Garamond",serif;color:var(--ink);font-size:clamp(2.2rem,3.5vw,3.25rem);font-weight:600}
    .step-label{display:block;margin-bottom:7px;color:#aa765f;font-size:.64rem;font-weight:700;letter-spacing:.19em;text-transform:uppercase}
    .field-help{margin:6px 0 14px;color:#738078;font-size:.79rem}
    .clear-btn{position:absolute;right:0;top:45px;border:0;background:transparent;color:#47665a;font-size:.71rem;font-weight:700;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
    .option-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
    .option-card{position:relative;min-height:174px;padding:24px 48px 22px 22px;text-align:left;border:1px solid var(--line);border-radius:20px;background:var(--white);cursor:pointer;user-select:none;-webkit-tap-highlight-color:transparent;transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease,background .22s ease,color .22s ease}
    .option-card:hover{border-color:var(--sage);transform:translateY(-3px);box-shadow:0 14px 32px rgba(24,33,29,.08)}
    .option-card[aria-checked="true"]{color:var(--white);border-color:var(--forest);background:var(--forest);box-shadow:0 16px 36px rgba(23,60,50,.2);transform:scale(1.012)}
    .option-icon{width:38px;height:38px;margin-bottom:20px;display:grid;place-items:center;border-radius:50%;background:var(--oat);color:var(--forest)}
    .option-icon svg{width:21px;height:21px}
    .option-card[aria-checked="true"] .option-icon{background:rgba(255,255,255,.14);color:var(--white)}
    .option-card strong{display:block;margin-bottom:7px;font-size:1rem}
    .option-card small{display:block;color:var(--muted);font-size:.8rem;line-height:1.45}
    .option-card[aria-checked="true"] small{color:#dfe8e3}
    .option-check{position:absolute;right:18px;top:18px;width:25px;height:25px;display:grid;place-items:center;border:1px solid currentColor;border-radius:50%;font-size:.7rem;opacity:.3}
    .option-card[aria-checked="true"] .option-check{opacity:1;color:var(--forest);border-color:var(--gold);background:var(--gold)}
    #allergenOpts{grid-template-columns:repeat(4,minmax(0,1fr))}
    #allergenOpts .option-card{min-height:82px;padding:18px 40px 18px 18px;display:flex;align-items:center}
    #allergenOpts .option-icon,#allergenOpts .option-card small{display:none}
    #allergenOpts .option-card strong{margin:0;font-size:.88rem}
    #allergenOpts .option-check{top:50%;transform:translateY(-50%)}
    .form-actions{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:0}
    .form-actions .btn{min-width:250px;min-height:48px;padding:11px 23px;background:linear-gradient(135deg,#a96f5b,#8f5e50);box-shadow:0 11px 26px rgba(143,94,80,.18)}
    .form-actions .btn:hover{background:#825448}
    .reset-btn{border:0;background:transparent;color:var(--forest);font-weight:700;cursor:pointer}
    .reset-btn:hover{text-decoration:underline;text-underline-offset:4px}
    .form-message{min-height:18px;margin:8px 0 0;color:var(--danger);font-size:.8rem}
    #findBtn.is-loading{gap:9px;cursor:wait}
    #findBtn.is-loading::before{content:"";width:15px;height:15px;flex:0 0 auto;border:2px solid rgba(255,255,255,.46);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
    #find-your-match button:disabled:not(#findBtn){opacity:.58;cursor:not-allowed;transform:none!important}

    /* Loading and result states */
    .results{position:relative;display:none;min-height:calc(100svh - var(--nav-h));margin-top:52px;padding:30px clamp(20px,3.2vw,44px) 46px;overflow:clip;background:#f6f3ec;border:1px solid rgba(69,91,77,.1);border-radius:28px;box-shadow:0 20px 58px rgba(65,50,39,.07);scroll-margin-top:calc(var(--nav-h) + 12px)}
    .results-header{display:flex;align-items:center;justify-content:space-between;gap:20px}
    .results-header h2{margin:0;font-size:clamp(3rem,5vw,5rem);line-height:.94}
    .results-count{flex:0 0 auto;padding:9px 15px;border:1px solid rgba(23,60,50,.18);border-radius:999px;background:rgba(255,255,255,.62);color:var(--forest);font-size:.82rem;font-weight:700}
    .results-meta{margin:8px 0 14px;color:var(--muted);font-size:.8rem;line-height:1.4}
    .loading,.empty-box,.error-box{display:none;padding:58px 24px;text-align:center;background:var(--paper);border:1px solid var(--line);border-radius:24px}
    .loading[style*="block"]{display:flex!important;align-items:center;flex-direction:column}
    .spinner{width:42px;height:42px;margin-bottom:18px;border:3px solid var(--sand);border-top-color:var(--forest);border-radius:50%;animation:spin .8s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .error-box{color:var(--danger);background:#fff7f5}
    .error-box .btn{margin-top:16px}

    /* Product results */
    #story{margin:0;padding:0}
    .story-shell{position:relative;height:var(--story-height,150vh);margin:0}
    .results-story-frame{position:sticky;top:calc(var(--nav-h) + 12px);height:calc(100svh - var(--nav-h) - 24px);display:grid;grid-template-rows:auto auto minmax(0,1fr);overflow:hidden}
    .featured-layout,.story-sticky{position:static;top:auto;height:auto;min-height:0;display:grid;grid-template-columns:minmax(0,52fr) minmax(0,48fr);gap:clamp(24px,3vw,46px);align-items:stretch;padding:8px 0 0;overflow:hidden}
    .story-details{align-self:stretch;height:100%;min-height:0}
    .story-stage{position:relative;height:100%;overflow:hidden;isolation:isolate;background:radial-gradient(circle at 50% 40%,var(--scene-glow,#d3ddc8) 0%,transparent 48%),radial-gradient(circle at 50% 45%,var(--scene-a,#f6f3e8) 0%,var(--scene-b,#d4ddc9) 84%);transition:background .18s linear}
    .story-stage::before{content:"";position:absolute;z-index:0;inset:9%;border:1px solid rgba(104,127,110,.24);border-radius:50%;box-shadow:inset 0 0 90px rgba(255,255,255,.5),0 0 0 12px rgba(255,255,255,.16),0 0 0 30px rgba(255,255,255,.07),0 0 0 31px rgba(104,127,110,.08);pointer-events:none}
    .story-stage::after{content:"";position:absolute;z-index:0;left:50%;top:47%;width:min(64%,440px);aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.62) 0%,rgba(255,255,255,0) 66%);pointer-events:none;animation:stageHalo 9s ease-in-out infinite}
    @keyframes stageHalo{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.82}50%{transform:translate(-50%,-50%) scale(1.06);opacity:1}}
    .story-product{position:absolute;z-index:2;inset:4% 7% 7%;display:grid;place-items:center;opacity:0;transform:translate3d(var(--product-x,0),var(--product-y,24px),0) scale(var(--product-scale,.96));visibility:hidden;pointer-events:none;transition:opacity 240ms ease,transform 420ms cubic-bezier(.22,.7,.2,1),visibility 0s linear 240ms;will-change:transform,opacity}
    .story-product.is-active{opacity:1;visibility:visible;transform:translate3d(0,0,0) scale(1);transition-delay:70ms,70ms,0s}
    .product-image-wrap{display:grid;place-items:center;overflow:visible;background:radial-gradient(circle at 46% 36%,#fffaf1 0%,#f1e8dc 48%,#dfd0c4 100%)}
    .product-image-wrap img{display:block;width:72%;height:72%;max-width:100%;max-height:100%;object-fit:contain;object-position:center;mix-blend-mode:normal;filter:drop-shadow(0 18px 18px rgba(42,27,31,.22)) saturate(1.025);transform:translate(var(--image-shift-x,0),var(--image-shift-y,0)) scale(var(--visible-scale,1)) scale(var(--hover-scale,1));transform-origin:center;transition:transform .42s cubic-bezier(.2,.78,.2,1),filter .4s ease}
    .story-product .product-image-wrap{width:100%;height:100%;padding:54px 44px 68px;border-radius:50%}
    .story-product .product-image-wrap img{width:72%;height:72%;max-width:430px;max-height:510px;object-fit:contain;filter:drop-shadow(0 30px 26px rgba(42,27,31,.25)) saturate(1.05) contrast(1.025)}
    .story-details{position:relative;width:100%;min-width:0;min-height:340px}
    .story-detail{position:absolute;inset:0;display:flex;align-items:flex-start;flex-direction:column;justify-content:center;text-align:left;opacity:0;visibility:hidden;pointer-events:none;transform:translate3d(var(--detail-x,22px),0,0);transition:opacity 200ms ease,transform 380ms cubic-bezier(.22,.7,.2,1),visibility 0s linear 200ms;will-change:opacity,transform}
    .story-detail.is-active{opacity:1;visibility:visible;pointer-events:auto;transform:translate3d(0,0,0);transition-delay:80ms,80ms,0s}
    .brand{color:var(--forest);font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
    .story-detail h3{max-width:11ch;margin:12px 0 16px;color:var(--ink);font-size:clamp(2.2rem,3.3vw,4rem);line-height:.96;text-wrap:balance;overflow-wrap:normal;word-break:normal}
    .story-detail h3.is-long-title{max-width:13ch;font-size:clamp(2rem,2.9vw,3.45rem);line-height:1}
    .product-type{margin:0;color:var(--muted);font-size:.88rem}
    .badges{display:flex;flex-wrap:wrap;gap:7px;margin:15px 0}
    .badge{padding:6px 10px;border-radius:999px;background:#e2ebe5;color:var(--forest);font-size:.7rem;font-weight:700}
    .badge.filter{background:#f1dfd6;color:#7b4638}
    .product-footer{width:100%;display:flex;align-items:baseline;justify-content:space-between;gap:14px;margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}
    .price{font-weight:700;font-size:1.08rem}
    .product-link{color:var(--forest);font-size:.84rem;font-weight:700;text-underline-offset:4px}
    .story-progress{position:absolute;z-index:5;left:50%;top:5%;display:inline-flex;align-items:center;gap:9px;min-width:132px;padding:10px 18px;border:1px solid rgba(199,165,102,.5);border-radius:999px;color:var(--forest);background:rgba(255,253,248,.9);box-shadow:0 8px 24px rgba(49,61,50,.1);backdrop-filter:blur(12px);font-size:.66rem;font-weight:750;letter-spacing:.2em;text-align:center;transform:translateX(-50%);transition:transform .3s cubic-bezier(.2,.78,.2,1),box-shadow .3s ease,border-color .3s ease}
    .story-progress::before{content:"";width:7px;height:7px;border-radius:50%;background:#e0bd68;box-shadow:0 0 0 3px rgba(224,189,104,.28),0 0 12px rgba(199,165,102,.7);transition:box-shadow .3s ease}
    .story-progress.is-changing{transform:translateX(-50%) scale(1.06);border-color:rgba(199,165,102,.85);box-shadow:0 12px 32px rgba(165,126,59,.22)}
    .story-progress.is-changing::before{box-shadow:0 0 0 4px rgba(224,189,104,.4),0 0 18px rgba(199,165,102,.95)}
    .story-arc{position:absolute;z-index:4;inset:0;pointer-events:none}
    .story-arc-track{position:absolute;left:8%;right:8%;top:9%;height:78%;border:1px dashed rgba(89,116,94,.34);border-bottom-color:transparent;border-radius:50% 50% 46% 46%;opacity:.85}
    .story-arc-track::after{content:"";position:absolute;left:5%;right:5%;top:4%;height:88%;border:1px solid rgba(199,165,102,.18);border-bottom-color:transparent;border-radius:50% 50% 46% 46%}
    .story-arc-point{position:absolute;width:36px;height:36px;display:grid;place-items:center;border:1px solid rgba(72,101,85,.25);border-radius:50%;color:rgba(38,63,51,.58);background:rgba(255,253,248,.78);box-shadow:0 5px 16px rgba(45,66,54,.1);font-size:.62rem;font-weight:750;letter-spacing:.06em;transform:translate(-50%,-50%) scale(.86);transition:color .35s ease,background .35s ease,border-color .35s ease,box-shadow .35s ease,transform .35s cubic-bezier(.2,.78,.2,1);pointer-events:auto;cursor:pointer}
    .story-arc-point:hover{color:var(--forest);border-color:rgba(199,165,102,.7);transform:translate(-50%,-50%) scale(.96)}
    .story-arc-point.is-active{color:#fff;border-color:#d9b765;background:var(--forest);box-shadow:0 0 0 5px rgba(255,253,248,.78),0 0 28px rgba(199,165,102,.7);transform:translate(-50%,-50%) scale(1.12)}
    .story-arc-indicator{position:absolute;z-index:5;width:14px;height:14px;border:2px solid #fff;border-radius:50%;background:#e0bd68;box-shadow:0 0 0 5px rgba(224,189,104,.22),0 0 22px rgba(177,133,48,.7);transform:translate(-50%,-50%)}
    .story-controls{position:absolute;z-index:6;left:22px;right:22px;bottom:24px;display:flex;justify-content:space-between;pointer-events:none}
    .story-control{width:46px;height:46px;display:grid;place-items:center;border:1px solid rgba(73,98,83,.24);border-radius:50%;color:var(--forest);background:rgba(255,253,248,.82);box-shadow:0 8px 22px rgba(42,61,50,.12);backdrop-filter:blur(10px);font-size:1.15rem;cursor:pointer;pointer-events:auto;transition:transform .25s ease,background .25s ease,color .25s ease,box-shadow .25s ease,opacity .25s ease}
    .story-control:hover{color:#fff;background:var(--forest);box-shadow:0 10px 28px rgba(23,60,50,.22);transform:scale(1.1)}
    .story-control:disabled{opacity:.28;cursor:default;transform:none;box-shadow:none}
    .more-title{display:none;margin:38px 0 26px;font-size:2.7rem}
    .more-title.visible{display:block;margin-top:40px}
    .product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
    .product-card{position:relative;display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid rgba(70,91,78,.11);border-radius:22px;background:#fffdf8;box-shadow:0 13px 34px rgba(53,48,40,.07);transition:transform .3s ease,box-shadow .3s ease}
    .product-card:hover{transform:translateY(-5px);box-shadow:0 20px 44px rgba(53,48,40,.1)}
    .product-card .product-image-wrap{aspect-ratio:1/1.04;margin:10px;padding:24px;border-radius:20px;background:radial-gradient(circle at 48% 40%,#fffdf8 0%,#eee7dc 58%,#dfe6dc 100%)}
    .product-card .product-image-wrap img{width:70%;height:70%;max-width:230px;max-height:270px}
    .product-body{display:flex;flex:1;flex-direction:column;padding:24px}
    .product-name{margin:8px 0 12px;color:var(--ink);font-size:1.55rem;line-height:1.08}
    .image-fallback{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:24px;text-align:center;color:var(--forest)}
    .fallback-mark{width:66px;height:66px;display:grid;place-items:center;border:1px solid rgba(23,60,50,.28);border-radius:50%;font-family:"Cormorant Garamond",serif;font-size:1.8rem;font-weight:600}
    .image-fallback small{font-size:.7rem;letter-spacing:.08em;text-transform:uppercase}

    /* Luxury consultation and product presentation */
    .match::before,.results::before{display:none}
    .match::before{width:230px;height:92px;left:-70px;top:360px;box-shadow:68px 52px 0 -1px rgba(158,173,151,.13),128px 92px 0 -1px rgba(158,173,151,.09)}
    .match-intro{max-width:720px;margin:0 0 28px;text-align:left}
    .match-intro h2{font-size:clamp(3.7rem,5.6vw,5.8rem)}
    .match-intro p{margin:0;max-width:560px}
    .match-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);gap:clamp(22px,3vw,42px);align-items:stretch}
    .filter-panel fieldset{margin-bottom:27px}
    .filter-panel fieldset+fieldset{padding-top:25px}
    .filter-panel legend{font-size:clamp(1.75rem,2.25vw,2.25rem);line-height:1}
    #skinProblemOpts{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
    #skinProblemOpts .option-card{min-height:94px;padding:14px 40px 12px 16px;isolation:isolate;overflow:hidden;color:#fff;border-color:rgba(255,255,255,.42);border-radius:17px;background-position:center;background-size:cover;text-shadow:0 1px 14px rgba(20,31,26,.34)}
    #skinProblemOpts .option-card::before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(100deg,rgba(18,42,34,.78),rgba(18,42,34,.2))}
    #skinProblemOpts .option-card[data-value="Dryness"]{background-image:url("../images/concerns/dryness.jpeg");background-position:52% 44%}
    #skinProblemOpts .option-card[data-value="Acne"]{background-image:url("../images/concerns/acne.jpeg");background-position:50% 48%}
    #skinProblemOpts .option-card[data-value="Redness"]{background-image:url("../images/concerns/redness.jpeg");background-position:48% 48%}
    #skinProblemOpts .option-card[data-value="Dehydration"]{background-image:url("../images/concerns/dehydration.webp");background-position:50% 45%}
    #skinProblemOpts .option-card:hover{border-color:rgba(199,165,102,.82);box-shadow:0 16px 35px rgba(28,52,42,.18)}
    #skinProblemOpts .option-card[aria-checked="true"]{border:2px solid #e1c16f;box-shadow:0 0 0 3px rgba(255,253,248,.9),0 0 26px rgba(225,193,111,.52),0 18px 38px rgba(69,51,34,.2);filter:brightness(1.1) saturate(1.08);transform:translateY(-2px)}
    #skinProblemOpts .option-icon{width:27px;height:27px;margin-bottom:6px;background:rgba(255,255,255,.18);color:#fff;backdrop-filter:blur(8px)}
    #skinProblemOpts .option-icon svg{width:17px;height:17px}
    #skinProblemOpts .option-card strong{margin-bottom:3px;font-size:.9rem}
    #skinProblemOpts .option-card small{color:rgba(255,255,255,.82);font-size:.66rem;line-height:1.3}
    #skinProblemOpts .option-check{color:#173c32;border-color:#d7b66f;background:#e5c982;opacity:0}
    #skinProblemOpts .option-card[aria-checked="true"] .option-check{opacity:1;color:#173c32}
    #allergenOpts{display:flex;flex-wrap:wrap;gap:7px}
    #allergenOpts .option-card{flex:1 1 148px;min-height:42px;padding:8px 44px 8px 15px;border-radius:999px;background:rgba(255,255,255,.64);border-color:rgba(80,101,85,.18);box-shadow:0 7px 18px rgba(54,48,40,.04)}
    #allergenOpts .option-card strong{font-size:.78rem;line-height:1.2;white-space:nowrap}
    #allergenOpts .option-check{right:11px;width:22px;height:22px;font-size:.62rem}
    #allergenOpts .option-card:hover{border-color:rgba(199,165,102,.7);transform:translateY(-1px)}
    #allergenOpts .option-card[aria-checked="true"]{color:var(--forest);border:1px solid #d0a950;background:linear-gradient(135deg,#fffdf5,#ead6a7);box-shadow:0 0 0 2px rgba(255,255,255,.86),0 0 24px rgba(208,169,80,.42),0 10px 24px rgba(127,96,48,.16);filter:brightness(1.04);transform:translateY(-1px)}
    #allergenOpts .option-card[aria-checked="true"] .option-check{color:var(--forest);background:#f0ce75;box-shadow:0 0 14px rgba(240,206,117,.65)}
    .match-visual{position:relative;min-height:545px;overflow:hidden;border:1px solid rgba(255,255,255,.64);border-radius:28px;background:linear-gradient(155deg,#dfe4d5 0%,#bdc8b5 48%,#8f9f8c 100%);box-shadow:0 24px 68px rgba(50,65,53,.16),inset 0 1px 0 rgba(255,255,255,.55)}
    .match-visual::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(31,51,42,.46),transparent 48%),linear-gradient(120deg,rgba(255,255,255,.2),transparent 38%)}
    .visual-halo{position:absolute;width:320px;height:320px;right:-68px;top:-75px;border:1px solid rgba(255,255,255,.48);border-radius:50%;box-shadow:0 0 0 40px rgba(255,255,255,.055),0 0 0 78px rgba(255,255,255,.035)}
    .visual-photo{position:absolute;inset:20px 20px 108px;overflow:hidden;border:1px solid rgba(255,255,255,.38);border-radius:112px 112px 22px 22px;box-shadow:0 20px 48px rgba(34,50,41,.2)}
    .visual-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 38%;filter:saturate(.94) contrast(1.02)}
    .visual-accent{position:absolute;z-index:3;right:5%;bottom:5%;width:128px;height:176px;object-fit:cover;object-position:52% 50%;border:2px solid rgba(255,255,255,.72);border-radius:70px 70px 24px 24px;box-shadow:0 24px 34px rgba(20,36,28,.3);filter:saturate(.92) contrast(1.03);animation:accentFloat 6.5s ease-in-out infinite}
    @keyframes accentFloat{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-9px,0)}}
    .visual-leaf{position:absolute;z-index:2;width:170px;height:62px;border-radius:100% 0 100% 0;background:linear-gradient(145deg,#5e795f,#aec0a4);box-shadow:inset 0 0 0 1px rgba(255,255,255,.18)}
    .visual-leaf::after{content:"";position:absolute;left:11%;right:7%;top:50%;height:1px;background:rgba(241,235,213,.55);transform:rotate(-12deg)}
    .visual-leaf-one{left:-38px;bottom:116px;transform:rotate(28deg)}
    .visual-leaf-two{right:-54px;top:72px;transform:rotate(-38deg) scale(.82)}
    .match-visual p{position:absolute;z-index:4;left:25px;bottom:20px;margin:0;color:#fff;font-family:"Cormorant Garamond",serif;font-size:1.65rem;line-height:.94;text-shadow:0 4px 20px rgba(18,42,34,.35)}
    .match-visual p em{color:#f3db9f;font-weight:600}

    /* Interactive three-part consultation selector */
    .match-layout{grid-template-columns:minmax(300px,.88fr) minmax(390px,1.12fr) minmax(170px,.46fr);gap:18px;align-items:stretch}
    .filter-panel{min-height:545px;display:flex;flex-direction:column;padding:30px 27px;border-color:rgba(67,103,88,.16);background:linear-gradient(155deg,rgba(255,253,247,.94),rgba(236,243,236,.83));box-shadow:0 22px 60px rgba(47,72,58,.1),inset 0 1px 0 rgba(255,255,255,.9)}
    .active-concern-copy{position:relative;min-height:185px;padding:6px 4px 25px;border-bottom:1px solid rgba(72,100,84,.14);overflow:hidden}
    .active-concern-copy::after{content:"";position:absolute;right:-25px;top:-30px;width:120px;height:120px;border:1px solid rgba(114,154,135,.18);border-radius:50%;box-shadow:0 0 0 24px rgba(136,170,150,.055)}
    .active-concern-copy h3{margin:4px 0 8px;color:#21483b;font-size:clamp(3rem,4.4vw,4.7rem);line-height:.82}
    .active-concern-copy p{max-width:330px;margin:0 0 9px;color:#536c61;font-size:.88rem;line-height:1.5}
    .active-concern-copy small{display:block;max-width:330px;color:#829088;font-size:.7rem;line-height:1.45}
    .active-concern-copy.is-switching h3,.active-concern-copy.is-switching p,.active-concern-copy.is-switching small{animation:concernCopyIn .55s cubic-bezier(.2,.78,.2,1) both}
    .ingredient-fieldset{margin:22px 0 20px!important;padding:0!important;border:0!important}
    .ingredient-fieldset legend{font-size:clamp(1.65rem,2vw,2.1rem)}
    .ingredient-fieldset .clear-btn{top:37px}
    .ingredient-fieldset .field-help{margin-bottom:12px}
    .filter-panel .form-actions{margin-top:auto}
    .filter-panel .form-actions .btn{min-width:190px;padding-inline:18px;font-size:.78rem}
    .concern-stage{position:relative;min-height:545px;overflow:hidden;border:1px solid rgba(255,255,255,.72);border-radius:28px;background:linear-gradient(155deg,#cbdcd2,#9ab9aa 55%,#6e9384);box-shadow:0 26px 72px rgba(43,72,58,.18),inset 0 1px 0 rgba(255,255,255,.7);isolation:isolate;transition:background .7s ease,box-shadow .7s ease}
    .concern-stage[data-concern="Acne"]{background:linear-gradient(155deg,#d8e4df,#a8c5bd 55%,#779d94)}
    .concern-stage[data-concern="Redness"]{background:linear-gradient(155deg,#eee0d8,#d8b8ae 55%,#a97972)}
    .concern-stage[data-concern="Dehydration"]{background:linear-gradient(155deg,#d7eceb,#9bcaca 55%,#5e9e9d)}
    .concern-stage-glow{position:absolute;z-index:-1;left:50%;top:44%;width:84%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.42),transparent 67%);filter:blur(8px);transform:translate(-50%,-50%);animation:concernGlow 6s ease-in-out infinite}
    .concern-stage-frame{position:absolute;inset:18px 18px 90px;overflow:hidden;border:1px solid rgba(255,255,255,.52);border-radius:145px 145px 25px 25px;box-shadow:0 24px 55px rgba(25,58,45,.24);transform:translate3d(var(--concern-x,0),var(--concern-y,0),0) scale(1.01);transition:transform .6s cubic-bezier(.2,.78,.2,1)}
    .concern-stage-frame img{width:100%;height:100%;object-fit:cover;object-position:center 44%;filter:saturate(.9) contrast(1.025);transition:opacity .3s ease,transform .65s cubic-bezier(.2,.78,.2,1),filter .45s ease}
    .concern-stage.is-switching .concern-stage-frame img{opacity:0;transform:scale(1.07) translateY(12px);filter:blur(4px) saturate(.8)}
    .concern-stage.is-entering .concern-stage-frame img{animation:concernImageIn .68s cubic-bezier(.2,.78,.2,1) both}
    .concern-stage-label{position:absolute;z-index:3;left:27px;bottom:21px;color:#fff;text-shadow:0 3px 18px rgba(16,48,36,.35)}
    .concern-stage-label span{display:block;margin-bottom:3px;font-size:.6rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.concern-stage-label strong{font-family:"Cormorant Garamond",serif;font-size:2rem;font-weight:600}
    .concern-stage-ripple{position:absolute;right:-34px;bottom:-30px;width:190px;height:190px;border:1px solid rgba(255,255,255,.34);border-radius:50%;box-shadow:0 0 0 28px rgba(255,255,255,.055),0 0 0 56px rgba(255,255,255,.03);animation:concernRipple 7s ease-in-out infinite}
    .concern-rail{min-height:545px;padding:16px 13px;border:1px solid rgba(255,255,255,.72);border-radius:26px;background:linear-gradient(165deg,rgba(247,250,245,.76),rgba(213,228,219,.64));box-shadow:0 20px 54px rgba(47,72,58,.1);backdrop-filter:blur(14px)}
    .rail-label{display:block;margin:3px 4px 12px;color:#557064;font-size:.57rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}
    .concern-rail #skinProblemOpts{display:grid;grid-template-columns:1fr;gap:10px}
    .concern-rail #skinProblemOpts .option-card{min-height:111px;padding:13px 34px 11px 12px;border-radius:19px;transform-origin:right center}
    .concern-rail #skinProblemOpts .option-card:hover{transform:translateX(-5px) scale(1.018)}
    .concern-rail #skinProblemOpts .option-card.is-preview{border-color:#c7ab67;box-shadow:0 0 0 2px rgba(255,255,255,.78),0 13px 30px rgba(38,72,57,.2);transform:translateX(-6px) scale(1.025)}
    .concern-rail #skinProblemOpts .option-card strong{font-size:.82rem}.concern-rail #skinProblemOpts .option-card small{display:none}.concern-rail #skinProblemOpts .option-icon{width:25px;height:25px;margin-bottom:5px}
    @keyframes concernCopyIn{from{opacity:0;transform:translate3d(-18px,12px,0)}to{opacity:1;transform:none}}
    @keyframes concernImageIn{from{opacity:0;transform:scale(1.06) translateY(12px)}to{opacity:1;transform:none}}
    @keyframes concernGlow{0%,100%{opacity:.62;transform:translate(-50%,-50%) scale(.94)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.07)}}
    @keyframes concernRipple{0%,100%{transform:scale(.9);opacity:.45}50%{transform:scale(1.08);opacity:.8}}

    /* Simplified selector refinement */
    .match .container{width:min(1420px,calc(100% - 64px))}
    .match-layout{--choice-bg:#eee2cd;--choice-border:#c8a76a;grid-template-areas:"controls visual rail";grid-template-columns:minmax(340px,.9fr) minmax(450px,1.25fr) minmax(220px,.52fr);gap:clamp(28px,2.8vw,44px);min-width:0}
    .match-layout[data-concern="Dryness"]{--choice-bg:#eee2cd;--choice-border:#c5a468}.match-layout[data-concern="Acne"]{--choice-bg:#dce9df;--choice-border:#81a68f}.match-layout[data-concern="Redness"]{--choice-bg:#efd9d5;--choice-border:#bc827b}.match-layout[data-concern="Dehydration"]{--choice-bg:#d5eaea;--choice-border:#72a7a5}
    .filter-panel{grid-area:controls;min-width:0;min-height:580px;padding:36px 32px}
    .active-concern-copy{min-height:146px;padding:4px 2px 27px}.active-concern-copy::after{display:none}
    .active-concern-copy h3{max-width:100%;margin:0 0 12px;font-size:clamp(3.15rem,3.55vw,4.15rem);line-height:.92;overflow-wrap:break-word;transition:color .4s ease}.active-concern-copy p{max-width:320px;margin:0;color:#60736a;font-size:.94rem;line-height:1.55}
    .active-concern-copy.is-switching h3,.active-concern-copy.is-switching p{animation:concernCopyIn .5s cubic-bezier(.2,.78,.2,1) both}
    .ingredient-fieldset{display:grid;margin:25px 0 22px!important;padding-top:0!important}.ingredient-fieldset legend{width:100%;font-size:1.95rem;line-height:1.12}.ingredient-fieldset .clear-btn{position:static;order:3;justify-self:end;margin:10px 2px 0;padding:2px 0;font-size:.72rem;line-height:1}
    .ingredient-fieldset .field-help{display:none}
    #allergenOpts{order:2;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:17px}
    #allergenOpts .option-card{min-width:0;min-height:54px;padding:10px 42px 10px 15px;background:rgba(255,255,255,.62);transition:background .4s ease,border-color .4s ease,box-shadow .4s ease,transform .28s ease,color .4s ease}
    #allergenOpts .option-card strong{overflow:visible;font-size:.79rem;line-height:1.25;text-overflow:clip;white-space:normal}
    #allergenOpts .option-check{right:12px;width:23px;height:23px;opacity:0}
    #allergenOpts .option-card[aria-checked="true"] .option-check{opacity:1}
    #allergenOpts .option-card[aria-checked="true"]{border-color:var(--choice-border);background:linear-gradient(135deg,rgba(255,255,255,.88),var(--choice-bg));box-shadow:0 0 0 2px rgba(255,255,255,.74),0 0 20px color-mix(in srgb,var(--choice-border) 38%,transparent)}
    .filter-panel .form-actions{display:grid;grid-template-columns:auto minmax(0,1fr);gap:15px}.filter-panel .form-actions .btn{width:100%;min-width:0;min-height:54px;padding-inline:16px;font-size:.86rem;white-space:normal;line-height:1.18}.reset-btn{padding:10px 4px;font-size:.84rem}
    .concern-stage{grid-area:visual;min-width:0;min-height:580px;transition:background .55s ease,border-color .45s ease,box-shadow .55s ease}
    .concern-stage[data-concern=""]{background:linear-gradient(145deg,#edf1e9,#dfe7df 54%,#c8d6cc);box-shadow:0 25px 70px rgba(51,76,62,.13),inset 0 1px 0 rgba(255,255,255,.88)}
    .concern-stage-glow{animation:none;transition:background .55s ease,opacity .55s ease}
    .concern-stage-frame{inset:18px;overflow:hidden;border-radius:145px 145px 29px 29px}
    .concern-stage-frame img{position:absolute;inset:0;width:100%;height:100%;opacity:0;object-fit:cover;object-position:center 44%;will-change:opacity,transform,filter}
    .concern-stage-frame img.is-current{opacity:1;transform:translate3d(0,0,0) scale(1)}
    .concern-stage-frame img.is-outgoing{animation:concernImageOut .64s cubic-bezier(.22,.7,.2,1) both}
    .concern-stage-frame img.is-incoming{animation:concernImageSlideIn .64s cubic-bezier(.22,.7,.2,1) both}
    .concern-neutral-video{position:absolute;z-index:2;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:0;pointer-events:none;mix-blend-mode:multiply;filter:saturate(.78) contrast(1.035) brightness(1.035);transform:translate3d(0,8px,0) scale(1.015);transition:opacity .72s ease,transform .7s cubic-bezier(.2,.78,.2,1),filter .5s ease;will-change:opacity,transform}
    .concern-stage.is-neutral .concern-stage-frame{inset:0;border:0;border-radius:27px;box-shadow:none}
    .concern-stage.is-neutral .concern-neutral-video{transform:translate3d(0,0,0) scale(1.035);animation:neutralVideoFloat 7s ease-in-out infinite alternate}
    .concern-stage.is-neutral .concern-neutral-video.is-visible{opacity:.92}
    .concern-stage.is-neutral .concern-neutral-video.is-fading{opacity:0}
    .concern-stage.is-neutral .concern-stage-frame img{opacity:0!important;animation:none!important}
    .concern-stage.is-neutral .concern-stage-glow{opacity:.75;background:radial-gradient(circle,rgba(255,247,222,.68),rgba(197,219,205,.28) 45%,transparent 72%)}
    .concern-stage-label,.concern-stage-ripple{display:none}
    .concern-rail{grid-area:rail;min-width:0;min-height:580px;padding:13px 12px}
    .concern-rail #skinProblemOpts{height:100%;display:grid;grid-template-columns:1fr;grid-template-rows:repeat(4,minmax(126px,1fr));gap:11px}
    .concern-rail #skinProblemOpts .option-card{--thumb-x:50%;--thumb-y:46%;min-width:0;min-height:126px;height:auto;display:flex;align-items:flex-end;padding:52px 42px 16px 16px;overflow:hidden;border-radius:19px;background-size:106%;background-repeat:no-repeat;background-position:var(--thumb-x) var(--thumb-y);transform-origin:right center;animation:concernThumbDrift 8.5s ease-in-out infinite alternate;transition:transform .35s cubic-bezier(.2,.78,.2,1),border-color .4s ease,box-shadow .4s ease,filter .4s ease,background-size .65s ease}
    .concern-rail #skinProblemOpts .option-card::before{background:linear-gradient(180deg,rgba(15,35,29,.06) 22%,rgba(15,35,29,.82) 100%)}
    .concern-rail #skinProblemOpts .option-card::after{content:"";position:absolute;z-index:1;inset:-35% -70%;pointer-events:none;background:linear-gradient(105deg,transparent 39%,rgba(255,255,255,.12) 48%,rgba(255,255,255,.04) 54%,transparent 62%);transform:translateX(-26%);animation:concernThumbLight 7.5s ease-in-out infinite}
    .concern-rail #skinProblemOpts .option-card strong{position:relative;z-index:2;margin:0;font-size:.92rem;line-height:1.15;white-space:normal}.concern-rail #skinProblemOpts .option-icon{position:absolute;z-index:2;left:14px;top:13px;width:30px;height:30px;margin:0}.concern-rail #skinProblemOpts .option-icon svg{width:17px;height:17px}
    .concern-rail #skinProblemOpts .option-check{z-index:3;right:12px;top:12px;width:25px;height:25px;opacity:0}
    .concern-rail #skinProblemOpts .option-card[aria-checked="true"] .option-check{opacity:1}
    .concern-rail #skinProblemOpts .option-card[data-value="Dryness"]{--thumb-x:54%;--thumb-y:44%;animation-delay:-1.2s}
    .concern-rail #skinProblemOpts .option-card[data-value="Acne"]{--thumb-x:50%;--thumb-y:46%;animation-delay:-3.1s}
    .concern-rail #skinProblemOpts .option-card[data-value="Redness"]{--thumb-x:55%;--thumb-y:48%;animation-delay:-4.8s}
    .concern-rail #skinProblemOpts .option-card[data-value="Dehydration"]{--thumb-x:52%;--thumb-y:43%;animation-delay:-6.4s}
    .concern-rail #skinProblemOpts .option-card:hover{background-size:113%}
    .concern-rail #skinProblemOpts .option-card.is-preview{border-color:var(--choice-border);box-shadow:0 0 0 2px rgba(255,255,255,.74),0 10px 24px color-mix(in srgb,var(--choice-border) 30%,transparent);filter:brightness(1.06) saturate(1.04);transform:translateX(-6px) scale(1.025)}
    .concern-rail #skinProblemOpts .option-card[aria-checked="true"]{border-color:#d1b36c;box-shadow:0 0 0 2px rgba(255,255,255,.78),0 0 20px rgba(209,179,108,.42)}
    .concern-rail #skinProblemOpts .option-card[data-value="Dryness"][aria-checked="true"]{border-color:#d0ad70;box-shadow:0 0 0 2px rgba(255,255,255,.8),0 0 22px rgba(208,173,112,.46)}
    .concern-rail #skinProblemOpts .option-card[data-value="Acne"][aria-checked="true"]{border-color:#8bae95;box-shadow:0 0 0 2px rgba(255,255,255,.8),0 0 22px rgba(112,157,127,.42)}
    .concern-rail #skinProblemOpts .option-card[data-value="Redness"][aria-checked="true"]{border-color:#c58a83;box-shadow:0 0 0 2px rgba(255,255,255,.8),0 0 22px rgba(190,119,112,.42)}
    .concern-rail #skinProblemOpts .option-card[data-value="Dehydration"][aria-checked="true"]{border-color:#78aaa8;box-shadow:0 0 0 2px rgba(255,255,255,.8),0 0 22px rgba(100,159,157,.42)}
    @keyframes concernImageOut{from{opacity:1;transform:translate3d(0,0,0) scale(1)}to{opacity:0;transform:translate3d(-8%,0,0) scale(.985);filter:blur(4px) saturate(.84)}}
    @keyframes concernImageSlideIn{from{opacity:0;transform:translate3d(8%,0,0) scale(1.03);filter:blur(5px) saturate(.82)}to{opacity:1;transform:translate3d(0,0,0) scale(1);filter:saturate(.9) contrast(1.025)}}
    @keyframes neutralVideoFloat{from{transform:translate3d(-4px,5px,0) scale(1.035)}to{transform:translate3d(5px,-5px,0) scale(1.055)}}
    @keyframes concernThumbDrift{from{background-size:106%;background-position:var(--thumb-x) var(--thumb-y)}to{background-size:112%;background-position:calc(var(--thumb-x) + 2%) calc(var(--thumb-y) - 2%)}}
    @keyframes concernThumbLight{0%,28%{opacity:0;transform:translateX(-28%)}48%{opacity:.85}68%,100%{opacity:0;transform:translateX(28%)}}
    .results #story,.results .more-title,.results .product-grid,.results .empty-box{transition:opacity .38s ease,transform .46s cubic-bezier(.2,.78,.2,1)}
    .results.is-settling #story,.results.is-settling .more-title,.results.is-settling .product-grid,.results.is-settling .empty-box{opacity:0;transform:translateY(14px)}
    .results.is-ready #story,.results.is-ready .more-title,.results.is-ready .product-grid,.results.is-ready .empty-box{opacity:1;transform:none}

    .results::before{width:190px;height:72px;right:-55px;top:180px;left:auto;transform:rotate(38deg);box-shadow:-56px 42px 0 -1px rgba(104,133,104,.1)}
    .results-header,.results-meta,#story,.more-title,.product-grid,.loading,.empty-box,.error-box{position:relative;z-index:1}
    .results-header h2::after,.more-title::after{content:"";display:block;width:54px;height:2px;margin-top:16px;background:linear-gradient(90deg,#b28e4f,#e3ca91)}
    .story-sticky{gap:clamp(24px,3.2vw,48px)}
    .story-stage{border:1px solid rgba(70,91,78,.1);border-radius:32px;box-shadow:0 24px 66px rgba(49,61,50,.12)}
    .story-product .product-image-wrap{background:transparent}
    .story-detail{padding:36px;border-left:1px solid rgba(199,165,102,.42)}
    .story-detail h3{max-width:11ch;font-size:clamp(2.2rem,3.3vw,4rem);line-height:.96;text-wrap:balance;overflow-wrap:normal;word-break:normal}
    .story-detail h3.is-long-title{max-width:13ch;font-size:clamp(2rem,2.9vw,3.45rem);line-height:1}
    .badge{border:1px solid rgba(89,116,94,.12);background:#e8eee7}
    .badge.filter{border-color:rgba(178,142,79,.15);background:#f3e6dc}
    .product-grid{gap:24px}
    .product-card::before{content:"";position:absolute;z-index:2;left:24px;top:0;width:52px;height:3px;border-radius:0 0 6px 6px;background:linear-gradient(90deg,#a98547,#e0c684)}
    .product-body{padding:21px 25px 25px}
    .product-name{min-height:3.15em;font-size:1.48rem}
    .product-footer{margin-top:auto}

    /* Footer */
    .site-footer{padding:54px 0 30px;background:var(--deep-forest);color:#cbd7d1}
    .footer-inner{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:45px;align-items:start}
    .footer-brand{font-family:"Cormorant Garamond",serif;color:var(--white);font-size:1.65rem;font-weight:600;letter-spacing:.08em}
    .footer-title{margin-bottom:10px;color:var(--gold);font-size:.68rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
    .footer-copy,.footer-list{margin:0;color:#cbd7d1;font-size:.75rem;line-height:1.75}
    .footer-list{padding:0;list-style:none}
    .footer-bottom{grid-column:1/-1;margin-top:15px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);font-size:.7rem;color:#9db0a8}

    /* Lightweight site-wide reveal and interaction polish */
    .motion-ready .reveal-on-scroll{opacity:0;transform:translate3d(0,34px,0);transition:opacity .78s ease,transform .88s cubic-bezier(.2,.78,.2,1)}
    .motion-ready .reveal-on-scroll.reveal-left{transform:translate3d(-34px,18px,0)}
    .motion-ready .reveal-on-scroll.reveal-right{transform:translate3d(34px,18px,0)}
    .motion-ready .reveal-on-scroll.is-visible{opacity:1;transform:none}
    .option-card,.product-card,.filter-panel,.match-visual{transition:transform .38s cubic-bezier(.2,.78,.2,1),box-shadow .38s ease,border-color .3s ease,filter .3s ease}
    .option-card:hover{transform:translateY(-4px);box-shadow:0 18px 36px rgba(36,57,45,.14)}
    .product-card{animation:productArrival .7s cubic-bezier(.2,.78,.2,1) both}
    #productGrid .product-card{isolation:isolate}
    #productGrid .product-card::after{content:"";position:absolute;z-index:3;inset:-45% auto -45% -34%;width:25%;pointer-events:none;background:linear-gradient(90deg,transparent,rgba(255,255,255,.68),transparent);opacity:0;transform:rotate(14deg) translateX(-180%);transition:transform .8s cubic-bezier(.2,.78,.2,1),opacity .25s ease}
    #productGrid .product-card:hover{transform:translateY(-9px) scale(1.012);border-color:rgba(199,165,102,.45);box-shadow:0 30px 72px rgba(36,57,45,.17),0 0 0 1px rgba(231,206,151,.25)}
    #productGrid .product-card:hover::after{opacity:1;transform:rotate(14deg) translateX(650%)}
    #productGrid .product-card:hover .product-image-wrap img{--hover-scale:1.055;filter:drop-shadow(0 26px 24px rgba(39,55,45,.23)) saturate(1.07)}
    #productGrid .product-card:hover .product-link{transform:translateX(5px);color:#9b7436}
    #productGrid .product-link{display:inline-block;transition:transform .3s ease,color .3s ease}
    #allergenOpts .option-card:hover{transform:translateY(-2px)}
    @keyframes productArrival{from{opacity:0;transform:translate3d(0,26px,0) scale(.985)}to{opacity:1;transform:none}}

    /* Richer More Matches product gallery */
    #productGrid .product-card{
      --stage-a:#eef2e8;--stage-b:#c8d6c7;--stage-c:#9fb3a5;--card-tint:#f9f6ee;--accent:#b9944f;
      border-color:rgba(57,83,69,.2);
      background:linear-gradient(165deg,#fffdf8 0%,var(--card-tint) 72%,#efe8da 100%);
      box-shadow:0 18px 46px rgba(38,57,47,.12),0 2px 0 rgba(255,255,255,.88) inset;
    }
    #productGrid .product-card:nth-child(4n+2){--stage-a:#f5e8df;--stage-b:#d7b9aa;--stage-c:#ae8677;--card-tint:#faf1eb;--accent:#bb7e69}
    #productGrid .product-card:nth-child(4n+3){--stage-a:#f4eedf;--stage-b:#dfcda5;--stage-c:#b89a62;--card-tint:#faf5e9;--accent:#c19c50}
    #productGrid .product-card:nth-child(4n+4){--stage-a:#e7eeee;--stage-b:#b7ceca;--stage-c:#779b94;--card-tint:#f0f6f3;--accent:#6e988c}
    #productGrid .product-card::before{
      left:25px;width:78px;height:4px;
      background:linear-gradient(90deg,var(--accent),#ead39b 64%,rgba(255,255,255,.7));
      box-shadow:0 3px 14px color-mix(in srgb,var(--accent) 35%,transparent);
    }
    #productGrid .product-card .product-image-wrap{
      position:relative;
      isolation:isolate;
      overflow:hidden;
      margin:12px;
      padding:30px;
      border:1px solid rgba(255,255,255,.68);
      border-radius:22px;
      background:
        radial-gradient(circle at 50% 43%,rgba(255,255,255,.88) 0 18%,rgba(255,255,255,.28) 42%,transparent 64%),
        linear-gradient(145deg,var(--stage-a) 0%,var(--stage-b) 58%,var(--stage-c) 100%);
      box-shadow:
        0 18px 38px rgba(38,57,47,.15),
        inset 0 1px 0 rgba(255,255,255,.9),
        inset 0 -32px 55px rgba(45,67,56,.1);
    }
    #productGrid .product-card .product-image-wrap::before{
      content:"";
      position:absolute;
      z-index:0;
      left:50%;
      top:49%;
      width:68%;
      aspect-ratio:1;
      border-radius:50%;
      background:radial-gradient(circle,rgba(255,255,255,.9) 0 14%,rgba(255,248,224,.5) 38%,transparent 70%);
      box-shadow:0 0 0 1px rgba(255,255,255,.32),0 0 48px rgba(255,255,255,.35);
      transform:translate(-50%,-50%);
      transition:transform .55s cubic-bezier(.2,.78,.2,1),opacity .4s ease;
    }
    #productGrid .product-card .product-image-wrap::after{
      content:"";
      position:absolute;
      z-index:2;
      inset:0;
      pointer-events:none;
      border-radius:inherit;
      background:linear-gradient(130deg,rgba(255,255,255,.42),transparent 29%,transparent 72%,rgba(30,57,45,.09));
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.28);
    }
    #productGrid .product-card .product-image-wrap img{
      position:relative;
      z-index:1;
      width:72%;
      height:72%;
      filter:
        drop-shadow(0 4px 2px rgba(45,54,48,.1))
        drop-shadow(0 24px 22px rgba(29,45,37,.28))
        saturate(1.065)
        contrast(1.035);
    }
    #productGrid .product-card .image-fallback{position:relative;z-index:1}
    #productGrid .product-body{padding:23px 27px 28px}
    #productGrid .brand{color:#47695b;font-size:.71rem}
    #productGrid .product-name{color:#17271f;font-size:1.55rem;line-height:1.06}
    #productGrid .product-type{color:#5c6e65;font-size:.84rem;font-weight:600}
    #productGrid .badges{gap:8px;margin:17px 0 19px}
    #productGrid .badge{
      border-color:rgba(61,101,79,.2);
      color:#244d3e;
      background:linear-gradient(135deg,#e1eee5,#cbded1);
      box-shadow:0 5px 13px rgba(51,82,65,.09),inset 0 1px 0 rgba(255,255,255,.8);
    }
    #productGrid .badge.filter{
      border-color:rgba(157,99,76,.2);
      color:#7b4335;
      background:linear-gradient(135deg,#f3ded4,#e9c8ba);
      box-shadow:0 5px 13px rgba(125,77,60,.09),inset 0 1px 0 rgba(255,255,255,.72);
    }
    #productGrid .product-footer{border-color:rgba(48,76,62,.16)}
    #productGrid .price{color:#183f32;font-size:1.16rem}
    #productGrid .product-link{color:#315f4e;text-decoration-color:rgba(185,148,79,.75);text-decoration-thickness:1px}
    #productGrid .product-card:hover{
      transform:translateY(-10px) scale(1.012);
      border-color:color-mix(in srgb,var(--accent) 58%,#667d70);
      box-shadow:0 34px 78px rgba(31,55,43,.2),0 0 0 1px rgba(235,211,158,.35);
    }
    #productGrid .product-card:hover .product-image-wrap{box-shadow:0 25px 52px rgba(30,54,42,.22),inset 0 1px 0 rgba(255,255,255,.95),inset 0 -36px 60px rgba(45,67,56,.12)}
    #productGrid .product-card:hover .product-image-wrap::before{opacity:1;transform:translate(-50%,-50%) scale(1.1)}
    #productGrid .product-card:hover .product-image-wrap img{
      --hover-scale:1.045;
      filter:drop-shadow(0 5px 2px rgba(45,54,48,.1)) drop-shadow(0 29px 27px rgba(25,43,34,.33)) saturate(1.1) contrast(1.045);
    }
    #productGrid{
      gap:18px;
      padding:20px;
      border:1px solid rgba(48,76,62,.2);
      border-radius:28px;
      background:
        radial-gradient(circle at 8% 8%,rgba(238,215,196,.52),transparent 28%),
        radial-gradient(circle at 92% 94%,rgba(111,145,127,.22),transparent 30%),
        linear-gradient(145deg,#e4e1d7 0%,#d4ddd3 52%,#c6d1c7 100%);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.72),0 22px 55px rgba(41,61,50,.13);
    }
    #productGrid .product-card{
      border-color:rgba(45,72,58,.27);
      border-radius:19px;
      box-shadow:0 15px 34px rgba(31,52,41,.15),0 1px 0 rgba(255,255,255,.92) inset;
    }
    #productGrid .product-card .product-image-wrap{
      aspect-ratio:1/.88;
      margin:8px;
      padding:18px;
      border-radius:17px;
    }
    #productGrid .product-card .product-image-wrap img{
      width:74%;
      height:74%;
      max-width:238px;
      max-height:278px;
    }
    #productGrid .product-body{padding:17px 20px 20px}
    #productGrid .brand{font-size:.66rem}
    #productGrid .product-name{min-height:2.45em;margin:6px 0 8px;font-size:1.34rem;line-height:1.04}
    #productGrid .product-type{font-size:.78rem}
    #productGrid .badges{gap:6px;margin:12px 0 13px}
    #productGrid .badge{padding:5px 8px;font-size:.64rem}
    #productGrid .product-footer{gap:10px;margin-top:12px;padding-top:13px}
    #productGrid .price{font-size:1.05rem}
    #productGrid .product-link{font-size:.77rem}

    /* Find Your Match onboarding */
    #find-your-match{padding-top:34px;scroll-margin-top:calc(var(--nav-h) + 12px)}
    #find-your-match .match-intro{max-width:920px;margin:0 0 15px}
    #find-your-match .match-intro .eyebrow{margin-bottom:7px}
    #find-your-match .match-intro h2{margin:0 0 7px;font-size:clamp(3.05rem,4.4vw,4.55rem);line-height:.9}
    #find-your-match .match-intro p{max-width:720px;font-size:.83rem;line-height:1.45}
    .match-steps{width:min(760px,100%);margin:0 0 18px;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none}
    .match-steps li{position:relative;min-width:0;display:flex;align-items:center;gap:9px;color:#78847d;font-size:.67rem;letter-spacing:.015em;transition:color .38s ease}
    .match-steps li:not(:last-child)::after{content:"";position:absolute;z-index:0;left:calc(100% - 38px);right:-38px;top:15px;height:1px;background:rgba(71,99,84,.2);transition:background .38s ease}
    .match-steps span{position:relative;z-index:1;width:30px;height:30px;display:grid;place-items:center;flex:0 0 auto;border:1px solid rgba(60,91,74,.22);border-radius:50%;background:#f8f5ed;color:#63756b;font-size:.67rem;font-weight:800;box-shadow:0 5px 14px rgba(45,67,55,.07);transition:color .38s ease,background .38s ease,border-color .38s ease,box-shadow .38s ease,transform .38s ease}
    .match-steps strong{min-width:0;font-weight:700;white-space:nowrap}
    .match-steps li.is-complete{color:#426858}.match-steps li.is-complete span{color:#fff;border-color:#739584;background:#739584}
    .match-steps li.is-complete::after{background:linear-gradient(90deg,#739584,#c7a566)}
    .match-steps li.is-active{color:#21493a}.match-steps li.is-active span{color:#fff;border-color:#c4a05d;background:#21493a;box-shadow:0 0 0 4px rgba(199,165,102,.18),0 8px 20px rgba(33,73,58,.18);transform:scale(1.06)}
    .selection-summary{margin:0 0 13px;padding:12px 14px;border:1px solid rgba(59,91,74,.14);border-radius:16px;background:linear-gradient(135deg,rgba(231,239,232,.84),rgba(249,242,230,.88));box-shadow:inset 0 1px 0 rgba(255,255,255,.8)}
    .selection-summary span{display:block;margin-bottom:3px;color:#9b7543;font-size:.57rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
    .selection-summary strong,.selection-summary small{display:block;overflow-wrap:anywhere}
    .selection-summary strong{color:#274c3d;font-size:.77rem;line-height:1.35}
    .selection-summary small{margin-top:2px;color:#66766e;font-size:.66rem;line-height:1.35}
    .cta-helper{margin:auto 0 7px;color:#65766d;font-size:.66rem;line-height:1.35}
    #find-your-match .filter-panel .form-actions{margin-top:0}
    #findBtn:disabled{opacity:1;color:#7e8782;border-color:rgba(78,99,87,.18);background:linear-gradient(135deg,#e9e7e0,#dddeda);box-shadow:inset 0 1px 0 rgba(255,255,255,.8);cursor:not-allowed}
    .concern-rail{position:relative;display:flex;flex-direction:column}
    .concern-start-hint{position:relative;margin:0 3px 10px;padding:7px 9px 7px 27px;border:1px solid rgba(187,148,75,.22);border-radius:12px;color:#5b6e64;background:rgba(255,251,240,.7);font-size:.61rem;font-weight:700;line-height:1.3;transition:opacity .35s ease,transform .35s ease,max-height .35s ease,margin .35s ease,padding .35s ease}
    .concern-start-hint span{position:absolute;left:9px;top:7px;color:#b78c43;animation:onboardingArrow 1.3s ease-in-out infinite alternate}
    .concern-start-hint.is-hidden{max-height:0;margin:0;padding-block:0;border-color:transparent;opacity:0;overflow:hidden;transform:translateY(-5px)}
    .concern-rail #skinProblemOpts{height:auto;flex:1;grid-template-rows:repeat(4,minmax(108px,1fr))}
    .concern-rail #skinProblemOpts .option-card{min-height:108px}
    .concern-rail.needs-guidance.is-visible::after{content:"";position:absolute;z-index:4;left:10px;right:10px;top:58px;height:108px;border:2px solid rgba(202,164,90,.62);border-radius:19px;pointer-events:none;animation:onboardingRing 1.65s .45s ease-out 1 both}
    .motion-ready .match-steps.reveal-on-scroll li{opacity:0;transform:translateY(10px)}
    .motion-ready .match-steps.reveal-on-scroll.is-visible li{opacity:1;transform:none;transition:opacity .48s ease,transform .55s cubic-bezier(.2,.78,.2,1),color .38s ease}
    .motion-ready .match-steps.reveal-on-scroll.is-visible li:nth-child(2){transition-delay:.09s}.motion-ready .match-steps.reveal-on-scroll.is-visible li:nth-child(3){transition-delay:.18s}
    @keyframes onboardingArrow{to{transform:translateX(4px)}}
    @keyframes onboardingRing{0%{opacity:0;box-shadow:0 0 0 0 rgba(199,165,102,.3)}30%{opacity:1}100%{opacity:0;box-shadow:0 0 0 13px rgba(199,165,102,0)}}

    /* One-frame desktop consultation composition */
    @media(min-width:1025px){
      #find-your-match{
        height:auto;
        min-height:0;
        max-height:none;
        padding:0 0 64px;
        overflow:visible;
      }
      #find-your-match>.container{height:auto}
      #find-your-match .match-head{
        height:calc(100svh - var(--nav-h));
        min-height:calc(100svh - var(--nav-h));
        max-height:calc(100svh - var(--nav-h));
        padding:18px 0;
        display:grid;
        grid-template-areas:"intro steps" "selector selector";
        grid-template-columns:minmax(0,1.08fr) minmax(500px,.92fr);
        grid-template-rows:auto minmax(0,1fr);
        column-gap:38px;
        row-gap:12px;
      }
      #find-your-match .match-intro{grid-area:intro;align-self:center;max-width:none;margin:0;min-width:0}
      #find-your-match .match-intro .eyebrow{display:none}
      #find-your-match .match-intro h2{margin:0 0 6px;font-size:clamp(2.45rem,3vw,3.25rem);line-height:.92;letter-spacing:-.025em}
      #find-your-match .match-intro p{max-width:690px;color:#5d7066;font-size:.82rem;line-height:1.45}
      #find-your-match .match-steps{grid-area:steps;align-self:center;width:100%;margin:0;padding:10px 14px;border:1px solid rgba(55,87,70,.1);border-radius:999px;background:rgba(255,253,247,.55);box-shadow:0 8px 26px rgba(45,67,55,.05),inset 0 1px 0 rgba(255,255,255,.8)}
      #find-your-match .match-steps li{gap:8px;font-size:.7rem}
      #find-your-match .match-steps li:not(:last-child)::after{left:calc(100% - 29px);right:-29px;top:14px;background:rgba(71,99,84,.16)}
      #find-your-match .match-steps span{width:28px;height:28px;font-size:.64rem;box-shadow:none}
      #find-your-match .match-steps strong{letter-spacing:.01em}
      #find-your-match .match-layout{
        grid-area:selector;
        height:100%;
        min-height:0;
        grid-template-columns:minmax(330px,.9fr) minmax(470px,1.34fr) minmax(205px,.5fr);
        gap:clamp(17px,1.45vw,22px);
      }
      #find-your-match .filter-panel,#find-your-match .concern-stage,#find-your-match .concern-rail{height:100%;min-height:0}
      #find-your-match .filter-panel{padding:21px 23px;border-color:rgba(57,92,73,.18);background:linear-gradient(155deg,rgba(255,254,250,.97),rgba(235,242,235,.88));box-shadow:0 20px 52px rgba(42,67,53,.11),inset 0 1px 0 #fff}
      #find-your-match .active-concern-copy{min-height:96px;padding:0 0 15px}
      #find-your-match .active-concern-copy h3{margin-bottom:7px;font-size:clamp(2.35rem,2.55vw,2.95rem);line-height:.94}
      #find-your-match .active-concern-copy p{font-size:.82rem;line-height:1.43}
      #find-your-match .ingredient-fieldset{margin:14px 0 10px!important}
      #find-your-match .ingredient-fieldset legend{font-size:1.48rem;letter-spacing:-.01em}
      #find-your-match #allergenOpts{gap:8px;margin-top:10px}
      #find-your-match #allergenOpts .option-card{min-height:43px;padding:8px 35px 8px 13px}
      #find-your-match #allergenOpts .option-card strong{font-size:.74rem}
      #find-your-match .ingredient-fieldset .clear-btn{margin-top:6px;font-size:.68rem}
      #find-your-match .selection-summary{margin-bottom:8px;padding:8px 12px;border-radius:13px}
      #find-your-match .selection-summary strong{font-size:.74rem}
      #find-your-match .selection-summary small{font-size:.64rem}
      #find-your-match .cta-helper{margin:auto 0 5px;font-size:.67rem}
      #find-your-match .filter-panel .form-actions{gap:10px}
      #find-your-match .filter-panel .form-actions .btn{min-height:45px;font-size:.81rem}
      #find-your-match .filter-panel .reset-btn{font-size:.78rem}
      #find-your-match .form-message{min-height:12px;margin-top:4px;font-size:.68rem}
      #find-your-match .concern-stage{border-color:rgba(255,255,255,.82);box-shadow:0 22px 58px rgba(42,68,54,.16),inset 0 1px 0 rgba(255,255,255,.85)}
      #find-your-match .concern-stage-frame{inset:12px;border-radius:120px 120px 24px 24px}
      #find-your-match .concern-stage-frame img{object-position:54% 44%}
      #find-your-match .concern-stage.is-neutral .concern-stage-frame{inset:0;border-radius:27px}
      #find-your-match .concern-stage.is-neutral .concern-neutral-video{object-position:56% center;transform-origin:56% center}
      #find-your-match .concern-rail{padding:10px 9px;border-color:rgba(255,255,255,.82);background:linear-gradient(165deg,rgba(250,252,248,.84),rgba(213,228,219,.7));box-shadow:0 18px 48px rgba(43,68,55,.1)}
      #find-your-match .concern-start-hint{margin-bottom:7px;padding-block:5px;font-size:.56rem}
      #find-your-match .concern-start-hint span{top:5px}
      #find-your-match .concern-rail #skinProblemOpts{min-height:0;gap:8px;grid-template-rows:repeat(4,minmax(0,1fr))}
      #find-your-match .concern-rail #skinProblemOpts .option-card{min-height:0;padding:39px 36px 12px 13px;border-radius:17px}
      #find-your-match .concern-rail #skinProblemOpts .option-card::before{background:linear-gradient(180deg,rgba(13,33,27,.02) 18%,rgba(13,33,27,.84) 100%)}
      #find-your-match .concern-rail #skinProblemOpts .option-card strong{font-size:.84rem;text-shadow:0 2px 13px rgba(10,27,22,.48)}
      #find-your-match .concern-rail #skinProblemOpts .option-icon{left:11px;top:10px;width:26px;height:26px}
      #find-your-match .concern-rail #skinProblemOpts .option-check{right:10px;top:10px;width:22px;height:22px}
      #find-your-match .concern-rail.needs-guidance.is-visible::after{left:9px;right:9px;top:47px;height:calc((100% - 68px)/4)}
      #find-your-match .results{margin-top:52px}
    }
    @media(min-width:1025px) and (max-height:760px){
      #find-your-match .match-head{padding:12px 0;row-gap:9px}
      #find-your-match .match-intro h2{font-size:2.55rem}
      #find-your-match .match-intro p{font-size:.7rem}
      #find-your-match .match-steps li{gap:7px}
      #find-your-match .match-steps span{width:28px;height:28px}
      #find-your-match .match-steps strong{font-size:.59rem}
      #find-your-match .match-layout{gap:16px}
      #find-your-match .filter-panel{padding:16px 20px}
      #find-your-match .active-concern-copy{min-height:78px;padding-bottom:11px}
      #find-your-match .active-concern-copy h3{font-size:2.35rem}
      #find-your-match .active-concern-copy p{font-size:.72rem}
      #find-your-match .ingredient-fieldset{margin:10px 0 8px!important}
      #find-your-match .ingredient-fieldset legend{font-size:1.35rem}
      #find-your-match #allergenOpts{margin-top:8px}
      #find-your-match #allergenOpts .option-card{min-height:39px}
      #find-your-match .selection-summary{padding:7px 11px;margin-bottom:6px}
      #find-your-match .cta-helper{font-size:.62rem;margin-bottom:3px}
      #find-your-match .filter-panel .form-actions .btn{min-height:41px}
      #find-your-match .concern-rail{padding:8px}
      #find-your-match .concern-start-hint{margin-bottom:5px;padding-block:3px}
      #find-your-match .concern-rail #skinProblemOpts{gap:5px}
      #find-your-match .concern-rail #skinProblemOpts .option-card{padding-top:33px;padding-bottom:8px}
      #find-your-match .concern-rail #skinProblemOpts .option-icon{top:7px;width:23px;height:23px}
      #find-your-match .concern-rail #skinProblemOpts .option-check{top:7px;width:20px;height:20px}
    }

    /* Responsive rules */
    @media(max-width:1024px){
      body{--nav-h:62px}
      .container{width:min(var(--container),calc(100% - 40px))}
      .option-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .match-layout{grid-template-areas:"controls rail" "visual visual";grid-template-columns:minmax(0,1fr) minmax(190px,.42fr);gap:20px}
      .concern-rail{grid-column:auto;min-height:500px}.concern-rail #skinProblemOpts{grid-template-columns:1fr;grid-template-rows:repeat(4,minmax(0,1fr))}
      .match-visual{min-height:520px}
      .visual-photo{inset:18px 18px 104px}
      .story-sticky{gap:4vw}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .footer-inner{grid-template-columns:1fr 1fr}
      .footer-brand{grid-column:1/-1}
    }
    @media(max-width:768px){
      body{--nav-h:58px}
      .container{width:calc(100% - 30px)}
      .nav-toggle{display:block}.nav-links{display:none;position:fixed;inset:var(--nav-h) 0 auto;padding:28px 24px 34px;background:rgba(250,247,240,.98);color:var(--forest);flex-direction:column;align-items:flex-start;border-bottom:1px solid var(--line);box-shadow:var(--shadow)}
      .nav-links.open{display:flex}
      .hero-bg,.hero-model-foreground{background-position:64% 50%}
      .hero-model-foreground{mask-image:linear-gradient(90deg,transparent 0 38%,rgba(0,0,0,.24) 46%,#000 58%);-webkit-mask-image:linear-gradient(90deg,transparent 0 38%,rgba(0,0,0,.24) 46%,#000 58%)}
      .home::before{background:linear-gradient(90deg,rgba(244,250,239,.94),rgba(238,247,234,.72) 58%,rgba(232,244,228,.14))}
      .hero-display-word{--display-opacity:.3;top:47%;width:150%;font-size:clamp(6rem,22vw,10rem)}
      .hero-copy{max-width:76%}
      .hero-copy h1{font-size:clamp(4.1rem,17vw,6.4rem)}
      .video-scroll{height:auto;padding:0;background:var(--deep-forest)}
      .video-sticky{position:relative;height:auto;min-height:0;display:block;padding-bottom:38px}
      .video-frame{position:relative;height:auto;aspect-ratio:4/5;clip-path:inset(0 round 0)}
      .video-frame video,.video-fallback{position:relative;aspect-ratio:4/5;object-fit:contain;object-position:center}
      .video-copy{width:calc(100% - 30px);height:auto}
      .video-moment{position:relative;left:auto!important;right:auto!important;bottom:auto!important;width:auto;margin:28px 0 0!important;text-align:left!important;font-size:clamp(2.7rem,12vw,4.4rem);opacity:1!important;transform:none!important}
      .video-moment:not(:first-child){display:none}
      .video-shade,.video-transition{display:none}
      .match{padding:58px 0 60px}
      .match-intro{margin-bottom:26px}.match-intro h2{font-size:clamp(3.5rem,13vw,5rem)}
      .match-steps{margin-bottom:20px}.concern-rail.needs-guidance.is-visible::after{display:none}
      .match-layout{grid-template-areas:"controls" "visual" "rail";grid-template-columns:1fr}
      .filter-panel{padding:26px 20px;border-radius:24px}
      .concern-stage{min-height:470px}.concern-rail{grid-column:auto;min-height:auto;overflow:hidden}.concern-rail #skinProblemOpts{display:flex;height:auto;overflow-x:auto;gap:10px;padding:2px 3px 8px;scroll-snap-type:x mandatory}.concern-rail #skinProblemOpts .option-card{flex:0 0 42%;min-height:102px;scroll-snap-align:start}
      .match-visual{min-height:440px;border-radius:24px}
      .visual-photo{inset:18px 18px 96px;border-radius:100px 100px 20px 20px}
      .visual-accent{right:5%;width:108px;height:150px}
      fieldset{margin-bottom:45px}fieldset+fieldset{padding-top:40px}
      .clear-btn{position:static;margin:-12px 0 20px;padding:0}.ingredient-fieldset .clear-btn{margin:10px 2px 0}
      #allergenOpts{grid-template-columns:repeat(2,minmax(0,1fr))}
      .form-actions{align-items:stretch;flex-direction:column-reverse}.form-actions .btn{width:100%;min-width:0}
      .results{margin-top:75px;padding:45px 18px 35px;border-radius:26px}
      .results-header{align-items:flex-start;flex-direction:column}
      .story-shell{height:auto}.story-sticky{position:relative;top:auto;height:auto;display:block;overflow:visible}
      .story-stage,.story-details,.story-progress{display:none}
      .more-title{display:block!important;margin-top:30px}
      .product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}#productGrid{padding:14px;border-radius:22px}
      .footer-inner{grid-template-columns:1fr;gap:28px}.footer-brand,.footer-bottom{grid-column:auto}
    }
    @media(max-width:480px){
      .hero-bg,.hero-model-foreground{background-position:61% 50%}
      .hero-model-foreground{mask-image:linear-gradient(90deg,transparent 0 43%,rgba(0,0,0,.2) 50%,#000 64%);-webkit-mask-image:linear-gradient(90deg,transparent 0 43%,rgba(0,0,0,.2) 50%,#000 64%)}
      .home::before{background:linear-gradient(90deg,rgba(244,250,239,.96),rgba(238,247,234,.8) 68%,rgba(232,244,228,.2))}
      .hero-display-word{--display-opacity:.24;left:54%;width:190%;font-size:6.8rem}
      .hero-copy{max-width:92%}
      .hero-copy h1{font-size:4.35rem}.hero-actions{flex-direction:column}.hero-actions .btn{width:100%}
      .match-steps{gap:5px}.match-steps li{align-items:flex-start;gap:6px}.match-steps span{width:26px;height:26px}.match-steps strong{font-size:.58rem;line-height:1.2;white-space:normal}.match-steps li:not(:last-child)::after{top:13px}
      .option-grid,#allergenOpts{grid-template-columns:1fr}
      .option-card{min-height:150px}#allergenOpts .option-card{min-height:72px}
      #skinProblemOpts{grid-template-columns:1fr}
      .concern-rail #skinProblemOpts{display:flex}.concern-rail #skinProblemOpts .option-card{flex-basis:76%}.concern-stage{min-height:410px}.concern-stage-frame{inset:14px}.concern-stage.is-neutral .concern-stage-frame{inset:0}.concern-neutral-video{inset:0;width:100%;height:100%}
      #skinProblemOpts .option-card{min-height:112px}
      #allergenOpts .option-card{flex-basis:100%;min-height:48px}
      .match-visual{min-height:390px}
      .visual-photo{inset:18px 18px 92px}
      .visual-accent{right:5%;bottom:5%;width:88px;height:120px}
      .match-visual p{left:22px;bottom:19px;font-size:1.65rem}
      .product-grid{grid-template-columns:1fr}#productGrid{padding:10px}
      .product-card .product-image-wrap{padding:20px}
    }

    /* Reduced-motion rules */
    @media(prefers-reduced-motion:reduce){
      *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
      .hero-display-word{opacity:.38!important;letter-spacing:-.07em!important;transform:translate(-50%,-50%) scale(1)!important}
      .hero-word,.hero-nature,.hero-subtitle,.hero-copy p,.hero-actions{opacity:1!important;clip-path:none!important;filter:none!important;transform:none!important}
      .hero-bg{inset:0;transform:scale(1)}
      .hero-model-foreground{inset:0;transform:scale(1)}
      .video-scroll{height:auto;padding:0;background:var(--deep-forest)}
      .video-sticky{position:relative;height:auto;display:block;padding-bottom:38px}
      .video-frame{position:relative;height:auto;aspect-ratio:16/10;clip-path:inset(0 round 0)}
      .video-frame video{display:none}.video-fallback{display:block;position:relative;aspect-ratio:16/10;object-fit:contain}
      .video-copy{height:auto}.video-moment{position:relative;left:auto!important;right:auto!important;bottom:auto!important;width:auto;margin:28px 0 0!important;opacity:1!important;transform:none!important}
      .video-moment:not(:first-child){display:none}.video-shade,.video-transition{display:none}
      .story-shell{height:auto}.story-sticky{position:relative;top:auto;height:auto;display:block}.story-stage,.story-details,.story-progress{display:none}.more-title{display:block!important}
    }
